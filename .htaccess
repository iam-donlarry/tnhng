<IfModule mod_rewrite.c>
Options +FollowSymLinks -MultiViews
RewriteEngine On

# 1. Redirect /index.php to root / or directory
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.php [NC]
RewriteCond %{REQUEST_METHOD} !POST
RewriteRule ^ %1/ [R=301,L]

# 2. Redirect direct requests for file.php to extensionless /file
# Exclude POST requests to preserve form bodies
# Exclude /api/ endpoints to prevent interrupting backend JSON endpoints
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.?]+)\.php [NC]
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally rewrite extensionless requests to file.php if file.php exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
